# Shared super-linter configuration.
#
# Consumed by:
#   - .github/workflows/lint.yml  (loaded into $GITHUB_ENV)
#   - docker-compose.yaml         (via `env_file`)
#
# Keep this to simple KEY=value pairs: no `export`, no quoting tricks.
# Per-linter config files go in .github/linters/.

# Don't lint files excluded by .gitignore.
IGNORE_GITIGNORED_FILES=true

# JSON delegated to pre-commit.
VALIDATE_BIOME_FORMAT=false
VALIDATE_JSCPD=false
VALIDATE_JSON_PRETTIER=false
VALIDATE_JSON=false
# Markdown delegated to pre-commit.
VALIDATE_MARKDOWN_PRETTIER=false
VALIDATE_MARKDOWN=false
VALIDATE_NATURAL_LANGUAGE=false
# Pre-commit is executed separately.
VALIDATE_PRE_COMMIT=false
# Disabled for conflicts with the isort version used in pre-commit.
#   Re-enable if you align your local isort with the super-linter image.
VALIDATE_PYTHON_ISORT=false
VALIDATE_XML=false
# YAML delegated to pre-commit.
VALIDATE_YAML_PRETTIER=false
VALIDATE_YAML=false
